# BigWigs packager config: https://github.com/BigWigsMods/packager
# The addon lives in a subfolder, so it is moved to the top of the zip and the
# rest of the repository is left out.
package-as: stash-or-trash

manual-changelog:
  filename: StashOrTrash/CHANGELOG.md
  markup-type: markdown

move-folders:
  stash-or-trash/StashOrTrash: StashOrTrash

ignore:
  - .github
  - tests
  - tools
  - README.md
  - LICENSE
